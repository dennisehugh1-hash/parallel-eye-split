<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/permHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnOverlayPerm"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="授予悬浮窗权限" />
            <Button
                android:id="@+id/btnNotifPerm"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="允许通知" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">
            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="开始（申请录屏）" />
            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="停止" />
        </LinearLayout>

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打开 / 关闭分屏" />

        <TextView
            android:id="@+id/lblSep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp" />
        <SeekBar
            android:id="@+id/seekSep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/orient_title" />
        <RadioGroup
            android:id="@+id/orientGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton
                android:id="@+id/orientForce"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/orient_force" />
            <RadioButton
                android:id="@+id/orientFollow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/orient_follow" />
        </RadioGroup>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/dir_title" />
        <RadioGroup
            android:id="@+id/dirGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/dirAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dir_auto" />
            <RadioButton
                android:id="@+id/dirLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dir_left" />
            <RadioButton
                android:id="@+id/dirRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dir_right" />
        </RadioGroup>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="@string/dir_help" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/fit_title" />
        <RadioGroup
            android:id="@+id/fitGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton
                android:id="@+id/fitFill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fit_fill" />
            <RadioButton
                android:id="@+id/fitContain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fit_contain" />
        </RadioGroup>
        <CheckBox
            android:id="@+id/chkDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/show_dots" />

        <TextView
            android:id="@+id/lblSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp" />
        <SeekBar
            android:id="@+id/seekSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/lblOffset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp" />
        <SeekBar
            android:id="@+id/seekOffset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/gestureHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFEFF3F7"
            android:padding="10dp"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="刷新方式（防止“画中画”无限套娃）" />
        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton
                android:id="@+id/modeLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="实时（约30帧，需在录屏弹窗中选择“单个应用”）" />
            <RadioButton
                android:id="@+id/modeInterval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="间歇刷新（整个屏幕也可用，会轻微闪烁）" />
        </RadioGroup>

        <TextView
            android:id="@+id/lblInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp" />
        <SeekBar
            android:id="@+id/seekInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textStyle="bold"
            android:text="@string/control_title" />
        <RadioGroup
            android:id="@+id/controlGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/controlOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/control_off" />
            <RadioButton
                android:id="@+id/controlLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/control_left" />
            <RadioButton
                android:id="@+id/controlRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/control_right" />
        </RadioGroup>
        <TextView
            android:id="@+id/a11yStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnA11y"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/btn_a11y" />
            <Button
                android:id="@+id/btnAppInfo"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/btn_app_info" />
        </LinearLayout>
        <TextView
            android:id="@+id/controlHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="恢复默认参数" />

        <TextView
            android:id="@+id/help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>
