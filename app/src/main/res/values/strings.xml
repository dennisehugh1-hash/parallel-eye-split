<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">平行眼分屏</string>
    <string name="a11y_label">平行眼分屏·可操控半屏</string>
    <string name="a11y_desc">用于“可操控半屏”功能：分屏开启时，把你在指定半屏画面上的点按、长按和滑动，换算成真实屏幕位置后代为执行，从而在分屏状态下操作下面的应用。本服务只模拟手势，不读取屏幕内容、不收集任何数据。</string>
    <string name="control_title">可操控半屏（需开启无障碍服务）</string>
    <string name="control_off">关闭</string>
    <string name="control_left">左半屏可操控</string>
    <string name="control_right">右半屏可操控</string>
    <string name="btn_a11y">开启无障碍服务</string>
    <string name="btn_app_info">应用信息</string>
    <string name="fit_title">画面适配</string>
    <string name="fit_fill">填满（裁切边缘，铺满半屏）</string>
    <string name="fit_contain">完整显示（等比适配，可能留黑边）</string>
    <string name="show_dots">显示对焦红圈（叠加在两个画面底部）</string>
    <string name="orient_title">分屏方向</string>
    <string name="orient_force">强制横屏（应用保持竖屏，分屏画面横着显示）</string>
    <string name="orient_follow">跟随系统方向</string>
    <string name="dir_title">横屏方向（仅“强制横屏”且系统为竖屏时有效）</string>
    <string name="dir_auto">自动</string>
    <string name="dir_left">向左</string>
    <string name="dir_right">向右</string>
    <string name="dir_help">向左：手机逆时针转，顶部朝左；向右：手机顺时针转，顶部朝右。自动：根据重力感应判断。</string>
</resources>
